[node name="Text" parent="Slides/StencilBuffer_summery" index="0" unique_id=1637018573 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Stencil Buffer"
header = ""
text = "Pros:
-Einfach zu implementieren
-Macht was es verspricht

Cons:
-Hat seine Limits / Nicht Flexible
-kann nicht lesen und schreiben in einem
-Shader Script Kann den Stencil nicht auslesen oder schreiben
-Shader Script kann die Stencil Layer nicht ändern"
bottom_text = ""

