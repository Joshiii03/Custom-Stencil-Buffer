[node name="Text" parent="Slides/ViewportExplanation" index="0" unique_id=577381041 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "ViewportBuffer"
header = ""
text = "-2x Viewports in Unteschiedliche Render Ebenen
-1. Viewport Textur -> StencilBuffer
-Kein Shading / Envrionment als Hintergrund Stencil
-Verschiedene Kanäle (RGB) -> mehrere Buffer

2. Viewport Textur -> normaler Color Buffer
-SUbviewportContainer auf Stretch
-Größe auf 1. Viewport übertragen"
bottom_text = ""

