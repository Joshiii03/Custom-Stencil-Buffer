[node name="StencilBuffer_HowTo" parent="Slides" index="12" unique_id=1789856615 instance=ExtResource("3_yh82q")]
slide_name = "StencilBuffer II"

[node name="Text" parent="Slides/StencilBuffer_HowTo" index="0" unique_id=1245823599 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Stencil Buffer wie?"
header = ""
text = "0. Standard Material anlegen
1. Immer Alpha aktivieren
2. Stencil -> 
   Custom / Outline / X-Ray
3. Select mode(Read  /Write)
4. Refernce / Stencillayer
    (256 Ebenen (0-255))
5. Compare (==, !=, >=,<=)
6. Render Priorität"
bottom_text = ""
picture_path = "res://assets/Screenshots/Material_Stencil.png"
picture_horizontal_offset = -0.8

[node name="StencilBuffer_Howto_Code" type="Node" parent="Slides" index="13" unique_id=2015583934]
