[node name="Text" parent="Slides/StencilBuffer_Howto_Code" index="0" unique_id=1937771385 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Stencil Buffer per Code"
header = ""
text = "Stencil_mode:
-Read / Write
-Stencillayer
-compare_equal,compare_greater,
compare_less, etc...

rendermode: (empfohlen)
depth_draw_always

Problem:
-Stencillayer nicht veränderbar :("
bottom_text = ""
picture_path = "res://assets/Screenshots/Stencil_ShaderCode.png"
picture_ratio = Vector2(2, 1)
