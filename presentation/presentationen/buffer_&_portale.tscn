[node name="Text" parent="Slides/Portale Klassisch" index="0" unique_id=1122722746 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Portale Klassisch"
header = ""
text = "Beispiele:
Portal 1&2, Chasing Carrots, (Prey 2006)
Viewporttexture wird aud das Portal gerenderd
2. Kamera wird auf die andere Seite gespiegelt
-Kamera Transform an Spieler Transform anpasse.
-Matrixen Mathe Magie
Prey(2006) nur eien Kamera und Stencil für Hilfe"
bottom_text = ""

[node name="Portale_DepthProblem" type="Node" parent="Slides" index="28" unique_id=1607896104]
script = ExtResource("7_ceemk")
slide_name = "Probleme"
metadata/_custom_type_script = "uid://dw5nch1euelxo"

[node name="Text" parent="Slides/Portale_DepthProblem" index="0" unique_id=1321819778 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Portale Tiefen Problem"
header = ""
text = "Wann ist ein Objekt Sichtbar?
3 Faktoren: 
Spieler Ebene, Portal Ebene, Portale Entfernung
1. Objekte davor sind dahinter -> Stencil schreiben
2.Problem Portal Entfernung == DepthBuffer
Depthtest Invertiert an Portal
Restlichen Depthtests gehen kaputt"
bottom_text = ""

[node name="Portale_DepthSolution" type="Node" parent="Slides" index="29" unique_id=1445297227]
script = ExtResource("7_ceemk")
slide_name = "Lösung a la Stencil"
metadata/_custom_type_script = "uid://dw5nch1euelxo"

[node name="Text" parent="Slides/Portale_DepthSolution" index="0" unique_id=415946253 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Lösung 1 "
header = ""
text = "Die Normale des Portal + Position = Ebene
Alle Objekte werden vor dem Portal Unsichtbar
float  z_coord = dot(v_vertex - portal_coords, portal_norm );
-> Vorschlag von Robert/Kosro

Neues Problem:
Nur Ein Portal pro Ebene & \"unschöne\" Lösung"
bottom_text = ""

[node name="Portale_ViewPort_Solution" type="Node" parent="Slides" index="30" unique_id=1816766835]
script = ExtResource("7_ceemk")
slide_name = "Lösung a la Viewport"
metadata/_custom_type_script = "uid://dw5nch1euelxo"

[node name="Text" parent="Slides/Portale_ViewPort_Solution" index="0" unique_id=868763090 instance=ExtResource("2_ry4wd")]
visible = false
slide_header = "Lösung2"
header = ""
text = "Gäbe es nur einen Zweiten Depthbuffer für Portale
-> Viewport für Portale
R -> Stencil
G/B -> Tiefe / Depthbuffer
B = Grobe tiefe
G = Preziese Tiefe

	vec4 clip_pos = PROJECTION_MATRIX * vec4(VERTEX, 1.0);
	float fragment_depth = clip_pos.z / clip_pos.w;"
bottom_text = ""

